<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Xalts Smoke Suite" parallel="classes">
	<listeners>
		<listener
			class-name="testComponents.TestAnalyzerListener" />
	</listeners>
	<test thread-count="10" name="Smoke Test">
		<groups>
			<run>
				<include name="Smoke" />
			</run>
		</groups>
		<classes>
			<class name="com.dhruvanshtanwar.xalts_submission.SignUpTest" />
			<class name="com.dhruvanshtanwar.xalts_submission.SignOutTest" />
			<class name="com.dhruvanshtanwar.xalts_submission.SignInTest" />
		</classes>
	</test> <!--
	Test -->
</suite> <!--
Suite -->
